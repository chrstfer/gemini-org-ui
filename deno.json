{
  "unstable": ["sloppy-imports"],
  "imports": {
    "@deno/emit": "jsr:@deno/emit@^0.46.0",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "tasks": {
    "build": "deno run -A build.ts",
    "watch": "deno run -A build.ts --watch",
    "test": "deno test -A tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "typecheck": "tsc --noEmit"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"]
  },
  "lint": {
    "include": ["src/", "tests/", "build.ts"],
    "exclude": ["dist/", "node_modules/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["src/", "tests/", "build.ts"],
    "exclude": ["dist/", "node_modules/"],
    "lineWidth": 120,
    "indentWidth": 4,
    "singleQuote": false,
    "semiColons": true
  }
}
