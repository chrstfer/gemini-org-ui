{
  "manifest_version": 3,
  "name": "Gemini Full-Width and org-mode Rendering Mod",
  "version": "0.1.0",
  "description": "High-density full-width layout and custom Org-mode rendering for Google Gemini",
  "homepage_url": "https://www.github.com/chrstfer/gemini-org-ui",
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-org-u@dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
